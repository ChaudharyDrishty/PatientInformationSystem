<UserControl x:Class="PatientInformationSystem.AddPatient.AddPatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add Patient" FontSize="20" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12">
            <StackPanel>

                <TextBlock Text="Patient Name"/>
                <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PatientNameError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Date of Birth" Margin="0,10,0,0"/>
                <DatePicker SelectedDate="{Binding DOB, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding DOBError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Gender" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding GenderOptions}"
                          SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding GenderError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Email" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding EmailError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Phone No" Margin="0,10,0,0"/>
                <TextBox Text="{Binding PhoneNo, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding PhoneNoError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Address" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding AddressError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Diagnosis" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         Height="70"/>
                <TextBlock Text="{Binding DiagnosisError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Surgery Status" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding SurgeryStatusOptions}"
                          SelectedItem="{Binding SurgeryStatus, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding SurgeryStatusError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

                <TextBlock Text="Consultant" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding ConsultantList}"
                          SelectedItem="{Binding Consultant, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding ConsultantError}" Foreground="Red" FontSize="12" Margin="0,2,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="Add Patient" Width="110"
                    Command="{Binding AddPatientCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>


















