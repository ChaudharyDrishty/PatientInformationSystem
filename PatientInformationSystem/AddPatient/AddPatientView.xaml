<UserControl x:Class="PatientInformationSystem.AddPatient.AddPatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PatientInformationSystem.AddPatient"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             Loaded="UserControl_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Padding="20" Background="White">
            <StackPanel>
                <TextBlock Text="Add Patient" FontSize="24" FontWeight="Bold" Foreground="#2E4053" Margin="0,0,0,20"/>

                <!-- Patient Name -->
                <TextBlock Text="Patient Name *" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"
                         Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Date of Birth -->
                <TextBlock Text="Date of Birth *" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <DatePicker Name="DOBPicker"
                            SelectedDate="{Binding DOB, UpdateSourceTrigger=PropertyChanged}" 
                            Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"
                            Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Email -->
                <TextBlock Text="Email *" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"
                         Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Phone Number -->
                <TextBlock Text="Phone Number *" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <TextBox Text="{Binding PhoneNo, UpdateSourceTrigger=PropertyChanged}" 
                         Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"
                         Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Address -->
                <TextBlock Text="Address" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" Padding="10" FontSize="12" Margin="0,0,0,15"
                         Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

                <!-- Diagnosis -->
                <TextBlock Text="Diagnosis" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" 
                         Height="80" Padding="10" FontSize="12" Margin="0,0,0,15"
                         Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>

                <!-- Surgery Status -->
                <TextBlock Text="Surgery Status" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding SurgeryStatusOptions}" 
                          SelectedItem="{Binding SurgeryStatus, UpdateSourceTrigger=PropertyChanged}"
                          Height="35" Padding="10" FontSize="12" Margin="0,0,0,15"
                          Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Consultant -->
                <TextBlock Text="Consultant Physician/Surgeon" FontSize="12" FontWeight="SemiBold" Foreground="#2E4053" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding ConsultantList}" 
                          SelectedItem="{Binding Consultant, UpdateSourceTrigger=PropertyChanged}"
                          Height="35" Padding="10" FontSize="12" Margin="0,0,0,20"
                          Background="#F5F5F5" BorderThickness="1" BorderBrush="#D0D0D0"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" FontWeight="SemiBold"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" FontSize="11" Margin="0,0,0,15" TextWrapping="Wrap" FontWeight="SemiBold"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Add Patient" 
                            Command="{Binding AddPatientCommand}"
                            Width="120" Height="40" Margin="0,0,10,0"
                            Background="#2E4053" Foreground="White" 
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Cancel" 
                            Command="{Binding CancelCommand}"
                            Width="120" Height="40"
                            Background="#95A5A6" Foreground="White" 
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
