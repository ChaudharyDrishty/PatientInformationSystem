<Window x:Class="PatientInformationSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PatientInformationSystem"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A5276" VerticalAlignment="Stretch">
            <TextBlock Text="Patient Records Management System" 
                       Foreground="White" 
                       FontSize="22" 
                       FontWeight="SemiBold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Background="#E5E8E8" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Search by:" 
                       Foreground="#2E4053" 
                       FontSize="14" 
                       FontWeight="SemiBold" 
                       VerticalAlignment="Center" 
                       Margin="0,0,10,0"/>

            <ComboBox Grid.Column="1" Width="150" Height="32" VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="Name"/>
                <ComboBoxItem Content="DOB"/>
                <ComboBoxItem Content="Status"/>
            </ComboBox>

            <TextBox Grid.Column="2" Name="SearchBox" Height="32" Margin="15,0" 
                     VerticalContentAlignment="Center" Padding="8,0"
                     GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
                     Text="Search patients..." Foreground="Gray"/>

            <Button Grid.Column="3" Content="+ Add Patient" 
                    Background="#0E8676" Foreground="White" 
                    FontWeight="SemiBold" FontSize="14"
                    Width="130" Height="34" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <DataGrid Grid.Row="2" Name="PatientGrid" AutoGenerateColumns="False" 
          CanUserAddRows="False" Background="White" RowHeight="40"
          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E8E8"
          BorderThickness="0" AlternatingRowBackground="#FAFAFA"
          ItemsSource="{Binding Patients}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2E4053"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,12"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    <Setter Property="BorderBrush" Value="#455A64"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.5*"/>
                <DataGridTextColumn Header="DOB" Binding="{Binding DOB, StringFormat=dd/MM/yyyy}" Width="1*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.8*"/>
                <DataGridTextColumn Header="Phone No." Binding="{Binding PhoneNo}" Width="1.2*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="2*"/>
                <DataGridTextColumn Header="Diagnosis" Binding="{Binding Diagnosis}" Width="1.5*"/>
                <DataGridTextColumn Header="Surgery Status" Binding="{Binding SurgeryStatus}" Width="1.2*"/>
                <DataGridTextColumn Header="Consultant Physician/Surgeon" Binding="{Binding Consultant}" Width="2*"/>

                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <Button Content="Edit" Padding="8,3" Margin="0,0,5,0" Background="#2980B9" Foreground="White" BorderThickness="0"/>
                                <Button Content="Delete" Padding="8,3" Margin="5,0,0,0" Background="#C0392B" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
