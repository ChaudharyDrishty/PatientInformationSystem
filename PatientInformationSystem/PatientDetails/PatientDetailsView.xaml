<UserControl x:Class="PatientInformationSystem.PatientDetails.PatientDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PatientInformationSystem.PatientDetails"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DataGrid
                Name="PatientGrid"
                AutoGenerateColumns="False"
                  CanUserAddRows="False"
                Background="White"
                RowHeight="40"
                  GridLinesVisibility="Horizontal"
                HorizontalGridLinesBrush="#E5E8E8"
                  BorderThickness="0"
                AlternatingRowBackground="#FAFAFA"
                  ItemsSource="{Binding Patients}">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"
                            Value="#2E4053"/>
                    <Setter Property="Foreground"
                            Value="White"/>
                    <Setter Property="FontWeight"
                            Value="SemiBold"/>
                    <Setter Property="Padding"
                            Value="10,12"/>
                    <Setter Property="FontSize"
                            Value="14"/>
                    <Setter Property="BorderThickness"
                            Value="0,0,1,0"/>
                    <Setter Property="BorderBrush"
                            Value="#455A64"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                        Binding="{Binding Name}"
                        Width="Auto"/>
                <DataGridTextColumn Header="DOB"
                        Binding="{Binding DOB, StringFormat=dd/MM/yyyy}"
                        Width="Auto"/>
                <DataGridTextColumn Header="Email"
                        Binding="{Binding Email}"
                        Width="Auto"/>
                <DataGridTextColumn Header="Phone No."
                        Binding="{Binding PhoneNo}"
                        Width="Auto"/>
                <DataGridTextColumn Header="Address"
                        Binding="{Binding Address}"
                        Width="*"
                        MinWidth="200"/>
                <DataGridTextColumn Header="Diagnosis"
                        Binding="{Binding Diagnosis}"
                        Width="Auto"/>
                <DataGridTextColumn Header="Surgery Status"
                        Binding="{Binding SurgeryStatus}"
                        Width="Auto"/>
                <DataGridTextColumn Header="Consultant Physician/Surgeon"
                        Binding="{Binding Consultant}"
                        Width="Auto"/>

                <DataGridTemplateColumn Header="Actions"
                        Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                    Margin="10,0">
                                <Button Content="Edit"
                                        Padding="8,3"
                                        Margin="5,2"
                                        Background="#2980B9"
                                        Foreground="White"
                                        BorderThickness="0"/>
                                <Button Content="Delete"
                                        Padding="8,3"
                                        Margin="5,2"
                                        Background="#C0392B"
                                        Foreground="White"
                                        BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
</UserControl>
